---
import { buttonBase, buttonSize, buttonVariant } from './classes';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  cta?: string;
  class?: string;
}
const { href, variant = 'primary', size = 'lg', cta, class: className = '' } = Astro.props;
---

<a href={href} data-cta={cta} class:list={[buttonBase, buttonSize[size], buttonVariant[variant], className]}>
  <slot />
</a>
