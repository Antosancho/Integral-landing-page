---
import { SITE } from '../../config/site';
interface Props {
  class?: string;
  decorative?: boolean;
}
const { class: className = '', decorative = false } = Astro.props;
---

<img
  src="/brand/factor-integral-horizontal-oscuro.png"
  width="296"
  height="72"
  alt={decorative ? '' : SITE.name}
  class:list={['h-7.5 w-auto', className]}
/>
