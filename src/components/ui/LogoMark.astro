---
import { SITE } from '../../config/site';
import { withBase } from '../../lib/paths';
interface Props {
  class?: string;
  decorative?: boolean;
  size?: 'md' | 'lg';
}
const { class: className = '', decorative = false, size = 'md' } = Astro.props;
const sizeClass = size === 'lg' ? 'h-14 w-auto' : 'h-10 w-auto';
---

<img
  src={withBase('/brand/factor-integral-horizontal-transparente.png', import.meta.env.BASE_URL)}
  width="296"
  height="72"
  alt={decorative ? '' : SITE.name}
  class:list={[sizeClass, className]}
/>
