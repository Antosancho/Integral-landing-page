---
import { SITE } from '../../config/site';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <span
    class="bg-surface border-border text-accent flex size-9 items-center justify-center rounded-xl border text-lg font-bold"
    aria-hidden="true">∫</span
  >
  <span class="font-extrabold">{SITE.name}</span>
</span>
