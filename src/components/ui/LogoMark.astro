---
import { SITE } from '../../config/site';
import { withBase } from '../../lib/paths';
interface Props {
  class?: string;
  decorative?: boolean;
}
const { class: className = '', decorative = false } = Astro.props;
---

<img
  src={withBase('/brand/factor-integral-horizontal-oscuro.png', import.meta.env.BASE_URL)}
  width="296"
  height="72"
  alt={decorative ? '' : SITE.name}
  class:list={['h-7.5 w-auto', className]}
/>
