---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import LogoMark from '../ui/LogoMark.astro';
import { hero } from '../../data/hero';
import { SITE } from '../../config/site';
import { buildWhatsAppUrl } from '../../lib/contact';

const wa = buildWhatsAppUrl(SITE.whatsapp);
---

<section id="inicio" aria-labelledby="inicio-titulo" class="pt-hero-top pb-hero flex flex-1 flex-col justify-center overflow-hidden">
  <Container class="text-center">
    <LogoMark decorative size="lg" class="mb-hero mx-auto hidden sm:block" />
    <p class="font-display text-info mb-hero text-xs font-bold tracking-overline uppercase">
      — {hero.overline} —
    </p>
    <SectionHeading as="h1" id="inicio-titulo" lines={hero.titleLines} accent />
    <p class="text-ink-muted mt-hero mx-auto max-w-2xl text-base sm:text-lg">{hero.lead}</p>
    <div class="mt-hero flex flex-col gap-3 sm:flex-row sm:justify-center">
      <Button href={hero.primary.href} cta={hero.primary.cta}>
        {hero.primary.label}
      </Button>
      <Button href={hero.secondary.href} cta={hero.secondary.cta} variant="secondary">
        {hero.secondary.label}
      </Button>
      {wa && (
        <Button href={wa} variant="secondary" external cta="hero-whatsapp">
          {hero.whatsappLabel}
        </Button>
      )}
    </div>
    <p class="border-border text-info rounded-field mt-hero inline-flex items-center gap-2 border px-4 py-1.5 text-sm font-medium">
      <svg
        viewBox="0 0 24 24"
        class="size-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      {hero.locationNote}
    </p>
  </Container>
</section>
