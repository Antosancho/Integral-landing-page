---
import Section from '../ui/Section.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { metodoIntro, steps } from '../../data/metodo';
---

<Section id="metodo">
  <SectionLabel text={metodoIntro.label} />
  <div class="mt-4">
    <SectionHeading id="metodo-titulo" lines={metodoIntro.titleLines} />
  </div>
  {metodoIntro.intro && <p class="text-ink-muted mt-6 max-w-2xl text-lg">{metodoIntro.intro}</p>}
  <ol class="mt-12 grid gap-6 sm:mt-16 md:grid-cols-2 lg:grid-cols-4">
    {steps.map((s) => (
      <Card as="li">
        <p class="font-display text-info text-xs font-bold tracking-overline">{s.number}</p>
        <h3 class="mt-3 text-xl font-extrabold">{s.title}</h3>
        <p class="text-ink-muted mt-3">{s.text}</p>
      </Card>
    ))}
  </ol>
</Section>
