---
import { SITE } from '../../config/site';
import { footer } from '../../data/footer';
import { buildWhatsAppUrl } from '../../lib/contact';

const wa = buildWhatsAppUrl(SITE.whatsapp);
const { label, withWhatsapp, withoutWhatsapp } = footer.floating;
const sub = wa ? withWhatsapp : withoutWhatsapp;
---

<a
  href={wa ?? '#contacto'}
  target={wa ? '_blank' : undefined}
  rel={wa ? 'noopener noreferrer' : undefined}
  data-cta="flotante"
  aria-label={`${label} ${sub}`}
  class="bg-cta text-on-cta hover:bg-cta-hover fixed right-4 bottom-4 z-40 flex flex-col rounded-full px-6 py-3 leading-tight font-bold shadow-lg transition-colors"
>
  <span>{label}</span>
  <span class="text-xs font-medium">{sub}</span>
</a>
