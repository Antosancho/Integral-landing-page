---
import { SITE } from '../../config/site';
import LogoMark from '../ui/LogoMark.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<header class="bg-surface-header fixed inset-x-0 top-0 z-50">
  <Container class="flex h-15 items-center justify-between gap-4">
    <a href="#inicio" aria-label={`${SITE.name}, ir al inicio`}>
      <LogoMark decorative />
    </a>
    <nav aria-label="Principal" class="hidden lg:flex">
      <ul class="flex items-center gap-1">
        {SITE.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-display text-ink-on-header-muted hover:text-ink-on-brand hover:bg-header-hover inline-flex h-9.5 items-center rounded-full px-3 text-sm font-bold whitespace-nowrap transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hidden lg:block">
      <Button size="md" href={SITE.headerCta.href} cta={SITE.headerCta.cta} class="whitespace-nowrap">
        {SITE.headerCta.label}
      </Button>
    </div>
    <button
      type="button"
      id="menu-toggle"
      class="text-ink-on-brand -mr-2 rounded-md p-2 lg:hidden"
      aria-controls="menu-movil"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </Container>
  <nav
    id="menu-movil"
    aria-label="Menú móvil"
    hidden
    class="bg-surface-header border-border border-t lg:hidden"
  >
    <Container class="flex flex-col gap-1 py-4">
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          class="text-ink-on-brand hover:bg-header-hover rounded-md px-3 py-3 font-semibold"
        >
          {item.label}
        </a>
      ))}
      <Button href={SITE.headerCta.href} cta={`${SITE.headerCta.cta}-movil`} class="mt-2">
        {SITE.headerCta.label}
      </Button>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    toggle.addEventListener('click', () => setOpen(menu.hidden === true));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
