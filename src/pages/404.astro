---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página no encontrada | Factor Integral" noindex>
  <main id="contenido" class="flex min-h-screen items-center py-20">
    <Container>
      <h1 class="text-h2 font-extrabold tracking-tight">Esta página no existe</h1>
      <div class="mt-8">
        <Button href="/">Volver al inicio</Button>
      </div>
    </Container>
  </main>
</BaseLayout>
